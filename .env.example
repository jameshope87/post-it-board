# Copy this file to .env and change the passphrase.
# Teachers need this passphrase to create a board. Students never need it.
TEACHER_PASSPHRASE=change-me-to-something-long

# Minutes a board stays open after the teacher's tab closes (covers refreshes / accidents)
GRACE_MINUTES=5

# Boards are always deleted after this many hours
BOARD_MAX_HOURS=2

# Safety limits
MAX_BOARDS=50
MAX_STUDENTS_PER_BOARD=40
